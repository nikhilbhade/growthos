# Meta retrieval orchestration agent (Google ADK). Server-side only.

# Node.js GrowthOS server that exposes the read-only retrieval endpoints.
GROWTHOS_API_URL=http://localhost:3000

# While Meta is not connected, retrieve against the Node service's demo data.
# Set to false once real Meta credentials are wired on the Node side.
GROWTHOS_DEMO=true

# Model that drives the orchestrator. Default is a native Gemini model, which
# needs a Google API key. To use Claude instead, set this to an
# "anthropic/claude-..." id and `pip install litellm`.
ORCHESTRATOR_MODEL=gemini-2.5-flash

# Google AI Studio key for the default Gemini model (or use Vertex AI vars).
# GOOGLE_API_KEY=

# HTTP timeout (seconds) for calls to the Node retrieval service.
GROWTHOS_REQUEST_TIMEOUT=15
