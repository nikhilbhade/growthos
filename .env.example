# Server-only credentials. Do not expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Service-to-service authentication for the provider microservices.
# Set a unique value in every deployed integration and ingestion service.
SERVICE_AUTH_TOKEN=replace-with-a-long-random-secret

# Agent model + memory configuration. Keep every value in this block server-side
# only — never expose it to the browser, a prompt, or an event payload. Locally
# these live in .env (gitignored); in production use a secrets manager.

# Anthropic model that powers the LangGraph agent. Without the key, the runtime
# uses the deterministic planner and preview mode still works against demo data.
# AGENT_MODEL_API_KEY=
# AGENT_MODEL_ID=claude-opus-5
# AGENT_MODEL_MAX_TOKENS=1024
# AGENT_MODEL_EFFORT=low

# Embedding model for semantic-memory vector search (LangGraph Store index).
# AGENT_EMBEDDING_MODEL=

# LangFuse observability (self-hostable). Traces stay on infrastructure you control.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Durable long-term memory (LangGraph checkpointer + store). Defaults to in-memory.
# AGENT_MEMORY_DATABASE_URL=

# Python knowledge service (M3 embedding retrieval). When unset, the agent uses a
# local fallback over the same corpus. SERVICE_AUTH_TOKEN (above) authenticates it.
# KNOWLEDGE_SERVICE_URL=http://localhost:4200
