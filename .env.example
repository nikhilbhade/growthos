# Server-only credentials. Do not expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public browser credential used only to initiate Supabase Auth. This is not a
# secret. Keep the service-role key server-side and never prefix it with VITE.
SUPABASE_ANON_KEY=sb_publishable_your-public-anon-key
# Set to true only after Google Auth is configured in Supabase and every
# production API has a verified JWT middleware layer.
GROWTHOS_REQUIRE_AUTH=false
# Comma-separated Google accounts permitted to access the authenticated workspace.
# When authentication is required, an empty list denies all access by design.
GROWTHOS_ALLOWED_EMAILS=founder@example.com,operator@example.com
PORT=3000

# Direct Postgres connection for bulk data loads (scripts/ingest-loop-data.mjs).
# Dashboard -> Project Settings -> Database -> Connection string. Use the direct
# connection or the SESSION pooler (port 5432) for COPY, not the transaction
# pooler (6543). Server-side only.
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Service-to-service authentication for the provider microservices.
# Set a unique value in every deployed integration and ingestion service.
SERVICE_AUTH_TOKEN=replace-with-a-long-random-secret

# Agent model + memory configuration. Keep every value in this block server-side
# only — never expose it to the browser, a prompt, or an event payload. Locally
# these live in .env (gitignored); in production use a secrets manager.

# Anthropic model that powers the LangGraph agent. Without the key, the runtime
# uses the deterministic planner and preview mode still works against demo data.
# AGENT_MODEL_API_KEY=
# AGENT_MODEL_ID=claude-opus-5
# AGENT_MODEL_MAX_TOKENS=1024
# AGENT_MODEL_EFFORT=low

# Vertex AI (recommended production provider). Cloud Run authenticates using its
# service account via Application Default Credentials; do not create a browser key.
# AGENT_MODEL_PROVIDER=vertex
# AGENT_MODEL_ID=gemini-2.5-flash-lite
# VERTEX_AI_PROJECT_ID=your-google-cloud-project-id
# VERTEX_AI_LOCATION=us-central1

# Embedding model for semantic-memory vector search. When the model + key are set
# the knowledge service uses a real provider; otherwise it uses a local, offline
# embedder. AGENT_EMBEDDING_DIMS must match the vector(N) width in migration 005.
# AGENT_EMBEDDING_MODEL=voyage-3
# AGENT_EMBEDDING_API_KEY=
# AGENT_EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings
# AGENT_EMBEDDING_DIMS=1024

# Postgres for the pgvector knowledge store (migration 005). When unset, the
# knowledge service keeps its index in memory. Defaults to AGENT_MEMORY_DATABASE_URL.
# KNOWLEDGE_DATABASE_URL=

# LangFuse observability (self-hostable). Traces stay on infrastructure you control.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Durable long-term memory (LangGraph checkpointer + store). Defaults to in-memory.
# AGENT_MEMORY_DATABASE_URL=

# Python knowledge service (M3 embedding retrieval). When unset, the agent uses a
# local fallback over the same corpus. SERVICE_AUTH_TOKEN (above) authenticates it.
# KNOWLEDGE_SERVICE_URL=http://localhost:4200
