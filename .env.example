# Server-only credentials. Do not expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Direct Postgres connection for bulk data loads (scripts/ingest-loop-data.mjs).
# Dashboard -> Project Settings -> Database -> Connection string. Use the direct
# connection or the SESSION pooler (port 5432) for COPY, not the transaction
# pooler (6543). Server-side only.
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Service-to-service authentication for the provider microservices.
# Set a unique value in every deployed integration and ingestion service.
SERVICE_AUTH_TOKEN=replace-with-a-long-random-secret

# Future model and vector-retrieval configuration. Keep these server-side only.
# AGENT_MODEL_API_KEY=
# AGENT_EMBEDDING_MODEL=
