# Server-only credentials. Do not expose the service role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Service-to-service authentication for the provider microservices.
# Set a unique value in every deployed integration and ingestion service.
SERVICE_AUTH_TOKEN=replace-with-a-long-random-secret

# Meta Marketing API — read + write / creative deployment.
# Track A starts in Development mode (no App Review). See
# docs/meta-development-mode-setup.md. Keep the secret and tokens server-side only.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
META_GRAPH_API_VERSION=v21.0
# Optional, for server-side testing before the in-app OAuth flow exists:
# META_SYSTEM_USER_TOKEN=
# META_TEST_AD_ACCOUNT_ID=
# META_TEST_PAGE_ID=
# META_TEST_IG_ACCOUNT_ID=

# Future model and vector-retrieval configuration. Keep these server-side only.
# AGENT_MODEL_API_KEY=
# AGENT_EMBEDDING_MODEL=
